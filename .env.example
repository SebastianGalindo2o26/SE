# Local demo uses SQLite. For Neon, use the PostgreSQL URL from Neon, including sslmode=require.
DATABASE_URL=sqlite:///./api_expert.db
REQUEST_TIMEOUT_SECONDS=8
SLOW_RESPONSE_MS=1500
# Comma-separated hostnames allowed to resolve to private/local addresses (useful for local demos).
ALLOWED_PRIVATE_HOSTS=localhost,127.0.0.1,::1
# Exact hostnames approved for monitoring. Add public API hosts here when authorized.
ALLOWED_TARGET_HOSTS=localhost,127.0.0.1,::1
# Host headers accepted by the local dashboard.
ALLOWED_APP_HOSTS=localhost,127.0.0.1
# Ejecuta python -m scripts.setup_credentials para generar la clave local.
# Si compartes una base Neon con otro equipo, copia la misma clave de forma segura.
CREDENTIALS_ENCRYPTION_KEY=
